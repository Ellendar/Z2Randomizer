<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:CrossPlatformUI"
             xmlns:tabs="clr-namespace:CrossPlatformUI.ViewModels.Tabs"
             Design.Width="{x:Static ui:MainWindowSize.MaxSectionColumnWidth}"
             x:DataType="tabs:SpriteCustomizationViewModel"
             x:Class="CrossPlatformUI.Views.Tabs.SpritePreviewView">
    <StackPanel Orientation="Vertical">
        <Image MaxHeight="200"
               Source="{Binding Path=Sprite?.Preview}"
               RenderOptions.BitmapInterpolationMode="None" />
        <TextBlock Margin="0,8,0,0" HorizontalAlignment="Center"
                   Text="{Binding Sprite?.Credit, FallbackValue='LOAD ROM FOR SPRITES'}" />
    </StackPanel>
</UserControl>
