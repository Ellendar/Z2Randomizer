<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="clr-namespace:CrossPlatformUI.Views"
             xmlns:ui="clr-namespace:CrossPlatformUI"
             xmlns:vm="clr-namespace:CrossPlatformUI.ViewModels"
             xmlns:z="clr-namespace:CrossPlatformUI.Controls"
             xmlns:lang="clr-namespace:Z2Randomizer.CrossPlatformUI.Lang"
             xmlns:core="clr-namespace:Z2Randomizer.RandomizerCore;assembly=RandomizerCore"
             Design.Width="{x:Static ui:MainWindowSize.TabPreviewWidth}"
             Design.Height="{x:Static ui:MainWindowSize.TabPreviewHeight}"
             x:Class="CrossPlatformUI.Views.Tabs.PalacesView"
             x:DataType="vm:MainViewModel">
    <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Auto">
        <v:FlexColumnsPanel Margin="4 16">
            <StackPanel Margin="0">
                <DockPanel Margin="0,0,0,-11">
                    <HyperlinkButton Classes="WikiLink" DockPanel.Dock="Right" Margin="8,12,18,0"
                                     Content="[Wiki: Palace Styles]"
                                     NavigateUri="https://github.com/Ellendar/Z2Randomizer/wiki/Palace-Styles" />
                    <TextBlock Text="Palace Styles" Classes="SectionHeader" VerticalAlignment="Top" />
                </DockPanel>
                <z:Z2ComboBox Flag="NormalPalaceStyle" />
                <z:Z2ComboBox Flag="GpStyle" />
                <z:Z2CheckBox Flag="RandomStylesAllowVanilla" />
            </StackPanel>

            <StackPanel Margin="0">
                <TextBlock Text="Room Pool" Classes="SectionHeader" Margin="0,12,0,-7" />
                <z:Z2ComboBox Flag="RoomPoolOption" />

                <StackPanel Margin="0"
                            IsVisible="{Binding Config.RoomPoolOption, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static core:RoomPoolOption.CUSTOM}}">
                    <TextBlock Margin="48 8 0 0" Text="{Binding RandomizerViewModel.CustomRoomPoolText}" TextWrapping="Wrap" />
                    <TextBlock Margin="48 0 0 8" Text="{Binding RandomizerViewModel.PalaceRoomsText}" TextWrapping="Wrap" />
                </StackPanel>
            </StackPanel>
            <StackPanel Margin="0"
                        IsVisible="{Binding Config.RoomPoolOption, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static core:RoomPoolOption.USE_CHECKBOXES}}">
                <z:Z2CheckBox Flag="IncludeVanillaRooms" Classes="DisabledMeansChecked" />
                <z:Z2CheckBox Flag="Includev4_0Rooms" />
                <z:Z2CheckBox Flag="Includev5_0Rooms" />
                <z:Z2CheckBox Flag="RemoveLongDeadEnds" />
                <z:Z2CheckBox Flag="IncludeExpertRooms" />
            </StackPanel>
            <StackPanel Margin="0">
                <z:Z2CheckBox Flag="NoDuplicateRoomsByLayout" />
                <z:Z2CheckBox Flag="NoDuplicateRoomsByEnemies" />
            </StackPanel>
            <z:Z2CheckBox Flag="BlockingRoomsInAnyPalace" />

            <TextBlock Text="Regular Palaces" Classes="SectionHeader" Margin="0,12,0,-7" />
            <z:Z2ComboBox Flag="NormalPalaceLength" />
            <z:Z2ComboBox Flag="KeyLogic" />
            <z:Z2ComboBox Flag="PalaceItemRoomCount" />
            <z:Z2ComboBox Flag="BossRoomsExitType" />

            <StackPanel Margin="0">
                <TextBlock Text="{x:Static lang:Resources.PalacesToCompleteMinCaption}" Classes="SectionCaption" />
                <Grid ColumnDefinitions="72,72" ColumnSpacing="8" Margin="17 8 17 4">
                    <z:Z2NumericUpDown Flag="PalacesToCompleteMin" Grid.Column="0" />
                    <z:Z2NumericUpDown Flag="PalacesToCompleteMax" Grid.Column="1" />
                </Grid>
            </StackPanel>

            <TextBlock Text="Great Palace" Classes="SectionHeader" Margin="0,12,0,-7" />
            <z:Z2ComboBox Flag="GpLength" />
            <z:Z2ComboBox Flag="DarkLinkMinDistance" />
            <StackPanel Margin="0">
                <z:Z2CheckBox Flag="TBirdRequired" Classes="DisabledMeansChecked" />
                <z:Z2CheckBox Flag="RemoveTBird" />
            </StackPanel>

            <TextBlock Text="Palace Drops" Classes="SectionHeader" Margin="0,12,0,-7" />
            <StackPanel Margin="0">
                <z:Z2ComboBox Flag="PalaceDropStyle" />
                <z:Z2CheckBox Flag="DropsMayBypassBosses" />
            </StackPanel>

            <TextBlock Text="Misc." Classes="SectionHeader" />
            <z:Z2CheckBox Flag="RandomizeBossItemDrop" />
            <z:Z2CheckBox Flag="ChangePalacePallettes" />
        </v:FlexColumnsPanel>
    </ScrollViewer>
</UserControl>
