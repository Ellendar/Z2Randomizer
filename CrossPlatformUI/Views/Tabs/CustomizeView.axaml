<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:tabs="clr-namespace:CrossPlatformUI.Views.Tabs"
             xmlns:vm="clr-namespace:CrossPlatformUI.ViewModels"
             xmlns:gen="clr-namespace:CrossPlatformUI.Controls.Generated"
             xmlns:z="clr-namespace:CrossPlatformUI.Controls"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="450"
             x:Class="CrossPlatformUI.Views.Tabs.CustomizeView"
             x:DataType="vm:MainViewModel">
    <Grid ColumnDefinitions="*,2*" Margin="4">
        <StackPanel Grid.Column="0" Orientation="Vertical">
            <z:Z2CheckBox Flag="RemoveFlashing" />
            <z:Z2CheckBox Flag="DarkenThunderbird" />
            <z:Z2CheckBox Flag="UpdatedHud" />
            <z:Z2CheckBox Flag="DisableHUDLag" />
            <z:Z2CheckBox Flag="FastSpellCasting" />
            <z:Z2CheckBox Flag="UpAOnController1" />
            <z:Z2ComboBox Flag="BeepThreshold" />
            <z:Z2ComboBox Flag="BeepFrequency" />
            <z:Z2CheckBox Flag="UseCommunityText" />
            <z:Z2CheckBox Flag="ShuffleSpritePalettes" />

            <Separator/>

            <z:Z2CheckBox Flag="DisableMusic" />

            <StackPanel Margin="0 0" Orientation="Vertical" IsVisible="{OnPlatform Default=True, Browser=False}">
                <HyperlinkButton
                    Margin="43 0"
                    HorizontalAlignment="Left"
                    Content="[Wiki: Custom Music]"
                    NavigateUri="https://github.com/Ellendar/Z2Randomizer/wiki/Custom-Music"
                    FontSize="12"
                    Foreground="#4557c4"
                    Cursor="Hand"
                />

                <z:Z2CheckBox Flag="RandomizeMusic" />
                <z:Z2CheckBox Flag="MixCustomAndOriginalMusic" />
                <z:Z2CheckBox Flag="IncludeDiverseMusic" />
                <z:Z2CheckBox Flag="DisableUnsafeMusic" />
            </StackPanel>
        </StackPanel>
        <tabs:SpritePreviewView Grid.Column="1" DataContext="{Binding SpritePreviewViewModel}" />
    </Grid>
</UserControl>
