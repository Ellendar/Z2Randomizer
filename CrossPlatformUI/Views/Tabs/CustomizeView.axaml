<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:CrossPlatformUI"
             xmlns:tabs="clr-namespace:CrossPlatformUI.Views.Tabs"
             xmlns:vm="clr-namespace:CrossPlatformUI.ViewModels"
             xmlns:v="clr-namespace:CrossPlatformUI.Views"
             xmlns:assists="clr-namespace:Material.Styles.Assists;assembly=Material.Styles"
             xmlns:lang="clr-namespace:Z2Randomizer.CrossPlatformUI.Lang"
             xmlns:z="clr-namespace:CrossPlatformUI.Controls"
             Design.Width="{x:Static ui:MainWindowSize.TabPreviewWidth}"
             Design.Height="{x:Static ui:MainWindowSize.TabPreviewHeight}"
             x:Class="CrossPlatformUI.Views.Tabs.CustomizeView"
             x:DataType="vm:MainViewModel">
    <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Auto">
        <v:FlexColumnsPanel Margin="4 16">
            <DockPanel Margin="0">
                <HyperlinkButton Classes="WikiLink" DockPanel.Dock="Right" Margin="8,12,18,0"
                                    IsVisible="{OnPlatform Default=True, Browser=False}"
                                    Content="[Wiki: Custom Music]"
                                    NavigateUri="https://github.com/Ellendar/Z2Randomizer/wiki/Custom-Music" />
                <TextBlock Text="Music" Classes="SectionHeader" VerticalAlignment="Top" />
            </DockPanel>
            <z:Z2CheckBox Flag="DisableMusic" />
            <StackPanel Margin="0" IsVisible="{OnPlatform Default=True, Browser=False}">
                <z:Z2CheckBox Flag="RandomizeMusic" />
                <z:Z2CheckBox Flag="MixCustomAndOriginalMusic" />
                <z:Z2CheckBox Flag="IncludeDiverseMusic" />
                <z:Z2CheckBox Flag="DisableUnsafeMusic" />
            </StackPanel>

            <StackPanel Margin="0">
                <TextBlock Text="Sprites" Classes="SectionHeader"  Margin="0,12,0,-7" />
                <ComboBox Margin="0,0,0,24" Theme="{StaticResource MaterialOutlineComboBox}"
                          Name="SelectedSprite" assists:ComboBoxAssist.Label="Character Sprite"
                          ItemsSource="{Binding SpriteCustomizationViewModel.Options}" SelectedItem="{Binding SpriteCustomizationViewModel.Sprite}">
                    <ToolTip.Tip><TextBlock Text="{x:Static lang:Resources.CharacterSpriteToolTip}" /></ToolTip.Tip>
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <Grid ColumnDefinitions="32, *">
                                <Image Grid.Column="0"
                                        Margin="4 2"
                                        Width="32"
                                        Height="64"
                                        Source="{Binding Preview}"
                                        RenderOptions.BitmapInterpolationMode="None" />
                                <TextBlock Grid.Column="1"
                                            Margin="16 0"
                                            VerticalAlignment="Center"
                                            Text="{Binding Name}" />
                            </Grid>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <z:Z2CheckBox Flag="ChangeItemSprites" />

                <TextBlock Text="Sprite Colors" Classes="SectionHeader" />
                <v:NesColorDropdown Label="Tunic Color"
                                    SelectedColorIndex="{Binding SpriteCustomizationViewModel.TunicColor}"
                                    DefaultColorIndex="{Binding SpriteCustomizationViewModel.SpriteTunicColor}">
                    <ToolTip.Tip><TextBlock Text="{x:Static lang:Resources.TunicColorToolTip}" /></ToolTip.Tip>
                </v:NesColorDropdown>
                <v:NesColorDropdown Label="Skin Tone"
                                    SelectedColorIndex="{Binding SpriteCustomizationViewModel.SkinTone}"
                                    DefaultColorIndex="{Binding SpriteCustomizationViewModel.SpriteSkinTone}">
                    <ToolTip.Tip><TextBlock Text="{x:Static lang:Resources.SkinToneToolTip}" /></ToolTip.Tip>
                </v:NesColorDropdown>
                <v:NesColorDropdown Label="Tunic Outline"
                                    SelectedColorIndex="{Binding SpriteCustomizationViewModel.OutlineColor}"
                                    DefaultColorIndex="{Binding SpriteCustomizationViewModel.SpriteOutlineColor}">
                    <ToolTip.Tip><TextBlock Text="{x:Static lang:Resources.TunicOutlineColorToolTip}" /></ToolTip.Tip>
                </v:NesColorDropdown>
                <v:NesColorDropdown Label="Shield Color"
                                    SelectedColorIndex="{Binding SpriteCustomizationViewModel.ShieldColor}"
                                    DefaultColorIndex="{Binding SpriteCustomizationViewModel.SpriteShieldColor}">
                    <ToolTip.Tip><TextBlock Text="{x:Static lang:Resources.ShieldColorToolTip}" /></ToolTip.Tip>
                </v:NesColorDropdown>
            </StackPanel>

            <z:Z2ComboBox Flag="BeamSprite" />
            <z:Z2CheckBox Flag="ShuffleSpritePalettes" />

            <TextBlock Text="Sprite Preview" Classes="SectionHeader" />
            <tabs:SpritePreviewView DataContext="{Binding SpriteCustomizationViewModel}" />
        </v:FlexColumnsPanel>
    </ScrollViewer>
</UserControl>
