<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vmt="clr-namespace:CrossPlatformUI.ViewModels.Tabs"
             xmlns:behaviors="clr-namespace:CrossPlatformUI.Behaviors"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="450"
             x:Class="CrossPlatformUI.Views.Tabs.PresetsView"
             x:DataType="vmt:PresetsViewModel">
    <UserControl.Styles>
        <Style Selector="Grid.diffRemoving">
            <!-- Duration matches RemovalFadeMilliseconds in PresetsViewModel. -->
            <Setter Property="Opacity" Value="0.5"/>
            <Style.Animations>
                <Animation Duration="0:0:0.25" FillMode="Forward" Easing="QuadraticEaseOut">
                    <KeyFrame Cue="0%">
                        <Setter Property="Opacity" Value="0.5"/>
                    </KeyFrame>
                    <KeyFrame Cue="85%">
                        <Setter Property="Opacity" Value="0.0"/>
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
    </UserControl.Styles>
    <Grid ColumnDefinitions="3*,5*" Margin="4">
        <Grid Grid.Column="0" RowDefinitions="*,Auto">
            <ListBox Grid.Row="0"
                     ItemsSource="{Binding Presets}"
                     SelectedItem="{Binding SelectedPreset}">
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vmt:PresetItem">
                    <Grid>
                        <TextBlock Text="{Binding Name}" IsVisible="{Binding IsCustom}" Foreground="{DynamicResource MaterialPrimaryMidBrush}"/>
                        <TextBlock Text="{Binding Name}" IsVisible="{Binding !IsCustom}"/>
                    </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <StackPanel Grid.Row="1" Margin="0 4" Orientation="Horizontal" HorizontalAlignment="Left">
                <Button Content="Save Flags as New Preset" Command="{Binding SaveNewPreset}"/>
            </StackPanel>
        </Grid>

        <Grid Grid.Column="1" Margin="16 0 0 0" RowDefinitions="Auto,Auto,Auto,*">
            <TextBlock Grid.Row="0" Text="{Binding Title}" FontSize="18" FontWeight="Bold"/>

            <TextBlock Grid.Row="1" Text="{Binding Description}"
                       TextWrapping="Wrap"
                       IsVisible="{Binding HasDescription}"/>

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Left" Margin="0 8 0 16">
                <Button Content="Load Preset" Command="{Binding LoadPreset}"/>
                <Button Content="Update Preset" Command="{Binding UpdatePreset}"/>
                <Button Content="Remove Preset" Command="{Binding RemovePreset}"/>
            </StackPanel>

            <Expander Grid.Row="3"
                      Classes="DiffExpander"
                      VerticalAlignment="Top"
                      IsVisible="{Binding HasDiff}"
                      IsExpanded="{Binding IsDiffExpanded, Mode=TwoWay}"
                      Header="Compare To Current Flags">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0 0">
                    <ItemsControl ItemsSource="{Binding DiffRows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vmt:PresetDiffRow">
                                <Grid ColumnDefinitions="3*,2*"
                                      Classes.diffRemoving="{Binding IsRemoving}"
                                      IsHitTestVisible="{Binding !IsRemoving}">
                                    <Interaction.Behaviors>
                                        <!-- Duration matches RemovalFadeMilliseconds in PresetsViewModel. -->
                                        <behaviors:CollapseOnRemovingBehavior Duration="0:0:0.25"/>
                                    </Interaction.Behaviors>
                                    <ContentControl Grid.Column="0" Content="{Binding Control}"
                                                    VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Value}"
                                               VerticalAlignment="Center"
                                               TextWrapping="Wrap"
                                               Margin="0 0 0 0"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Expander>
        </Grid>
    </Grid>
</UserControl>
