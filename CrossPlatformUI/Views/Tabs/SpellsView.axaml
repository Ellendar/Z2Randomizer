<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vmt="clr-namespace:CrossPlatformUI.ViewModels.Tabs"
             xmlns:gen="clr-namespace:CrossPlatformUI.Controls.Generated"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="600"
             x:Class="CrossPlatformUI.Views.Tabs.SpellsView"
             x:DataType="vmt:SpellsViewModel">
    <Grid ColumnDefinitions="*, *">
        <StackPanel Grid.Column="0">
            <gen:ShuffleLifeRefillAmount />
            <gen:ShuffleSpellLocations />
            <gen:DisableMagicContainerRequirements />
            <gen:RandomizeSpellSpellEnemy />
            <gen:SwapUpAndDownStab />
            <gen:FireOption />
        </StackPanel>
        <StackPanel Grid.Column="1">
            <gen:JumpAlwaysOn />
            <gen:DashAlwaysOn />
            <gen:PermanentBeamSword />
            <gen:MarioMode />
            <gen:FluteWarpMode />
        </StackPanel>
    </Grid>
</UserControl>
