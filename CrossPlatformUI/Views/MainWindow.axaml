<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:CrossPlatformUI"
        xmlns:views="clr-namespace:CrossPlatformUI.Views"
        xmlns:vm="clr-namespace:CrossPlatformUI.ViewModels"
        x:DataType="vm:MainViewModel"
        Design.Width="{x:Static ui:MainWindowSize.DefaultWidth}"
        Design.Height="{x:Static ui:MainWindowSize.DefaultHeight}"
        x:Class="CrossPlatformUI.Views.MainWindow"
        WindowStartupLocation="Manual"
        SizeToContent="Manual"
        MinHeight="{x:Static ui:MainWindowSize.MinHeight}"
        MinWidth="{x:Static ui:MainWindowSize.MinWidth}"
        Title="Z2Randomizer">
    <views:MainView />
</Window>
